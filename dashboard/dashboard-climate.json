{
  "dashboard": {
    "url_path": "dashboard-climate",
    "title": "空调",
    "icon": "mdi:air-conditioner",
    "show_in_sidebar": true,
    "require_admin": false
  },
  "config": {
    "title": "空调",
    "views": [
      {
        "title": "空调",
        "path": "overview",
        "type": "sections",
        "max_columns": 4,
        "sections": []
      }
    ]
  },
  "generator": {
    "type": "climate",
    "card": {
      "type": "tile",
      "icon": "mdi:power",
